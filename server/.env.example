PORT=5000
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5435/doc_verify_db?schema=public"

# JWT Authentication
JWT_SECRET="replace_with_strong_random_secret"
JWT_EXPIRES_IN="24h"

# Pinata IPFS Configuration (provide PINATA_JWT or API Key/Secret pair)
PINATA_JWT=""
PINATA_API_KEY=""
PINATA_SECRET_API_KEY=""
PINATA_GATEWAY="https://gateway.pinata.cloud/ipfs"
IPFS_MOCK="false"

# AI Verification Microservice
AI_SERVICE_URL="http://localhost:8000"
AI_SERVICE_TIMEOUT_MS=10000

# Blockchain Provider & Signer
BLOCKCHAIN_NETWORK="localhost"
BLOCKCHAIN_RPC_URL="http://127.0.0.1:8545"
BLOCKCHAIN_PRIVATE_KEY=""
CONTRACT_ADDRESS=""
